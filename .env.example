# Every specialist falls back to deterministic output when no key is set, so the
# app runs with this file empty.

# DeepSeek is the default provider for all five tasks.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# MiniMax runs two independent account systems and their keys are NOT
# interchangeable: a mainland-China key returns HTTP 401 "invalid api key
# (2049)" against the international host and vice versa. The default below is
# the mainland-China endpoint; the international one is https://api.minimax.io/v1
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# true = deterministic fixtures, no network. false = OpenStreetMap
# (Nominatim + OSRM), which is free but rate-limited -- set a descriptive
# user agent if you enable it in a deployment.
USE_MOCK_TOOLS=true
OSM_USER_AGENT=ai-trip-planner/1.0 (local development)

# Optional LangSmith tracing. With these set, every specialist, the conflict
# detector and each LangGraph node appear as spans on one trace tree, which is
# how a non-converging negotiation is diagnosed.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-trip-planner
